.dialog_container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    align-content: center;
    background-color: rgba(0, 0, 0, 0.95);
}

.dialog_window {
    width: 70%;
    height: 20%;
    background-color: rgba(221, 221, 221, 0.2);
    flex-direction: column;
    align-items: stretch;
    justify-content: space-around;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.msg_container {
    flex-direction: column;
    justify-content: center;
    width: 100%;
    height: auto;
    flex-grow: 0;
    flex-wrap: wrap;
    align-self: center;
    align-items: center;
    align-content: auto;
    -unity-text-align: upper-center;
}

.horizontal_container {
    flex-direction: row;
    justify-content: space-around;
}

.popup_slider {
    width: 100%;
    align-self: center;
    -unity-text-align: middle-center;
    font-size: 6px;
    -unity-font-style: bold;
    height: auto;
    left: auto;
    position: relative;
    justify-content: center;
    align-content: center;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/hanna.ttf?fileID=12800000&guid=0d69b729b63c77741a8cfa8c8980a7c6&type=3#hanna");
    flex-grow: 0;
    flex-wrap: wrap;
    align-items: center;
    text-shadow: 0 0 0 rgb(0, 0, 0);
    -unity-text-outline-color: rgb(255, 255, 255);
    flex-direction: row;
}

.popup_msg {
    font-size: 8px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/hanna.ttf?fileID=12800000&guid=0d69b729b63c77741a8cfa8c8980a7c6&type=3#hanna");
}

.popup_button {
    width: 35%;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
    color: rgb(255, 255, 255);
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    font-size: 7px;
    background-color: rgba(10, 4, 4, 0);
    text-shadow: 0 0 0 rgb(255, 255, 255);
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/hanna.ttf?fileID=12800000&guid=0d69b729b63c77741a8cfa8c8980a7c6&type=3#hanna");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.button_cancel {
    background-color: rgba(232, 237, 223, 0);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/hanna.ttf?fileID=12800000&guid=0d69b729b63c77741a8cfa8c8980a7c6&type=3#hanna");
}

.button_confirm {
    background-color: rgba(232, 237, 223, 0);
}
