.dialog_container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    align-content: center;
    background-color: rgba(0, 0, 0, 0.95);
}

.dialog_window {
    width: 100%;
    height: 50%;
    background-color: rgba(221, 221, 221, 0.2);
    flex-direction: column;
    align-items: stretch;
    justify-content: space-around;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.msg_container {
    flex-direction: column;
    justify-content: center;
}

.horizontal_container {
    flex-direction: row;
    justify-content: space-around;
}

.popup_slider {
    width: 60%;
    align-self: auto;
    -unity-text-align: middle-left;
    font-size: 6px;
    -unity-font-style: bold;
    height: auto;
    left: auto;
    position: relative;
    justify-content: flex-start;
    align-content: auto;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/hanna.ttf?fileID=12800000&guid=0d69b729b63c77741a8cfa8c8980a7c6&type=3#hanna");
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.unity-slider-int {
    width: 95%;
    align-items: center;
    justify-content: center;
    align-content: center;
    flex-direction: row;
    margin: 0;
    height: auto;
}

.unity-slider-int__label {
    -unity-text-align: middle-center;
    min-width: 0;
}

#unity-drag-container {
    width: 90%;
    -unity-text-align: middle-center;
}

#unity-dragger {
    width: 5%;
    height: 50%;
    justify-content: center;
    margin-top: -7px;
    -unity-text-align: middle-center;
}

#unity-tracker {
    height: 10%;
    color: rgba(255, 255, 255,1);
    -unity-text-align: middle-center;
    border-left-width : 0px;
    border-right-width : 0px;
    border-top-width : 0px;
    border-bottom-width : 0px;
}



.popup_msg {
    font-size: 8px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.popup_button {
    width: 35%;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
    color: rgb(255, 255, 255);
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    font-size: 7px;
    background-color: rgba(10, 4, 4, 0);
    text-shadow: 0 0 0 rgb(255, 255, 255);
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/hanna.ttf?fileID=12800000&guid=0d69b729b63c77741a8cfa8c8980a7c6&type=3#hanna");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.button_cancel {
    background-color: rgba(232, 237, 223, 0);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/hanna.ttf?fileID=12800000&guid=0d69b729b63c77741a8cfa8c8980a7c6&type=3#hanna");
}

.button_confirm {
    background-color: rgba(232, 237, 223, 0);
}
